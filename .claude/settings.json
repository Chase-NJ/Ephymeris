{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(pytest:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(sidecar/.venv/bin/python:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(arduino-cli:*)",
      "Bash(sh firmware/libraries/BehaviorBox/extras/host_test/*)",
      "Bash(cargo:*)",
      "Edit(/**)",
      "Write(/**)",
      "Read(/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous-git.py"
          }
        ]
      }
    ]
  }
}
