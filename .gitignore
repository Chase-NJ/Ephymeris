.DS_Store

# Claude Code: CLAUDE.md, shared settings, skills, agents and hooks are tracked so every
# worktree session loads them; personal settings and local memory stay on this machine.
CLAUDE.local.md
.claude/*
!.claude/settings.json
!.claude/review-ii-run.md
!.claude/skills/
!.claude/agents/
!.claude/hooks/
.mcp.json

# Frontend
node_modules/
dist/
*.local

# Rust / Tauri
src-tauri/target/
src-tauri/gen/schemas/
# Staged by scripts/package-resources.mjs; regenerated per build
src-tauri/resources/


# Python sidecar
sidecar/.venv/
sidecar/build/
sidecar/dist/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Stray sidecar logs from a manual run.
sidecar/*.err
sidecar/*.out
