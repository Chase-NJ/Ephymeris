!.claude/hooks/
.mcp.json
docs/agents/

# Frontend
node_modules/
dist/
dist-electron/
*.local

# Packaging: resources staged by scripts/package-resources.mjs, and electron-builder's output
/build/
/release/


# Python sidecar
sidecar/.venv/
sidecar/build/
sidecar/dist/
__pycache__/
*.py[cod]
.pytest_cache/
