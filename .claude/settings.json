{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(pytest:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(sidecar/.venv/bin/python:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(arduino-cli:*)",
      "Bash(sh firmware/libraries/BehaviorBox/extras/host_test/*)",
      "Bash(cargo:*)",
      "Edit(/**)",
      "Write(/**)",
      "Read(/**)"
    ],
    "deny": [
      "Edit(~/Documents/Hart-Lab/DATA/**)",
      "Edit(~/Library/Application Support/edu.hartlab.ephymeris/**)",
      "Edit(~/Library/Application Support/Ephymeris/**)",
      "Edit(/sidecar/tests/fixtures/legacy_*.json)",
      "Edit(/sidecar/tests/golden/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(gh workflow run:*)",
      "Bash(arduino-cli upload:*)",
      "Bash(sudo:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/filter_output.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 180,
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_gate.py\""
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyWrite": [
        "~/Documents/Hart-Lab/DATA",
        "~/Library/Application Support/edu.hartlab.ephymeris",
        "~/Library/Application Support/Ephymeris"
      ]
    },
    "network": {
      "allowLocalBinding": true
    }
  }
}
